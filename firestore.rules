rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mobile app admin (admins/ collection)
    function isAppAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dashboard user (any role)
    function isDashboardUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/dashboard_users/$(request.auth.uid));
    }

    // Dashboard admin specifically
    function isDashboardAdmin() {
      return isDashboardUser() &&
        get(/databases/$(database)/documents/dashboard_users/$(request.auth.uid)).data.role == "admin";
    }

    // Either admin type
    function isAdmin() {
      return isAppAdmin() || isDashboardAdmin();
    }

    // Registered ambulances
    function isAmbulance() {
      return isAuthenticated() && (
        request.auth.token.role == "ambulances" ||
        request.auth.token.role == "paramedic" ||
        // Fallback: check users collection for role
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ambulances"
      );
    }

    function isAssignedAmbulance(ambId) {
      return isAuthenticated() && (
        ambId == request.auth.uid ||
        (request.auth.token.role in ["ambulances", "paramedic"] && (request.auth.token.ambulancesId == ambId || request.auth.uid == ambId)) ||
        // Absolute fallback: Verify that the ambulance document is owned by this user
        get(/databases/$(database)/documents/ambulances/$(ambId)).data.uid == request.auth.uid
      );
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Users  (shared profile — both citizen and paramedic have a doc here)
    // Written at registration by the mobile app
    // ═══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Own read/write
      allow read, write: if isOwner(userId);

      // Dashboard + App Admin can read (for medical profile in SOS)
      allow read: if isDashboardUser() || isAppAdmin();

      // Ambulances can read for incident context
      allow read: if isAmbulance();

      // Only admins can delete
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Citizens  (role-specific collection for exists() checks)
    // ═══════════════════════════════════════════════════════════════════════

    match /citizens/{userId} {
      allow read: if isOwner(userId) || isAmbulance() || isDashboardUser() || isAppAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin() || isDashboardUser();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Incidents (unified)
    //
    // Unified schema fields used in rules:
    //   reportedBy        — who created the incident (citizen uid)
    //   assignment.ambulanceId — assigned ambulance uid
    //   status, assignment, assignedHospital, timeline, resolvedAt — protected
    // ═══════════════════════════════════════════════════════════════════════

    match /ambulances/{docId} {
      allow read: if isAuthenticated();
      // Relaxed update rule: Check UID field for ownership instead of custom claim
      // as custom claims might be stale during the first login session.
      allow update: if (isAuthenticated() && (resource.data.uid == request.auth.uid || docId == request.auth.uid)) || isAdmin();
      allow create, delete: if isAdmin() || isDashboardUser();
    }

    match /criticals/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /incidents/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read: if isAuthenticated()
        && isAssignedAmbulance(resource.data.ambulanceId);
      allow update: if isAuthenticated()
        && isAssignedAmbulance(resource.data.ambulanceId);
      allow create: if isAuthenticated();
    }

    match /_counters/{docId} {
      allow read, write: if true;
    }

    match /medical_reports/{reportId} {
      // Allow any authenticated user to create a report
      // Security is handled by the fact that they must be a paramedic to reach this screen
      allow create: if isAuthenticated();

      // Allow reading if the user is the one who wrote it, or an admin
      allow read: if isAuthenticated() && (
        resource.data.ambulanceId == request.auth.uid ||
        isAmbulance() ||
        isDashboardUser() ||
        isAppAdmin()
      );

      // Immutable
      allow update, delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Ambulance History  (written only by Cloud Functions)
    // ═══════════════════════════════════════════════════════════════════════

    match /ambulance_history/{historyId} {
      allow create, update, delete: if false;

      allow read: if isAdmin()
        || isDashboardUser()
        || isAssignedAmbulance(resource.data.ambulanceId);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Mission Cancellations  (immutable after creation)
    // ═══════════════════════════════════════════════════════════════════════

    match /mission_cancellations/{docId} {
      allow create: if isAssignedAmbulance(request.resource.data.ambulanceId);

      allow read: if isAdmin()
        || isDashboardUser()
        || isAssignedAmbulance(resource.data.ambulanceId);

      allow update, delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Join Requests  (public form submission)
    // ═══════════════════════════════════════════════════════════════════════

    match /join_requests/{requestId} {
      // Anyone can submit (public form, no auth required)
      allow create: if true;

      // Only dashboard/admin can read and process
      allow read, update: if isAdmin() || isDashboardUser();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Patient Profiles  (legacy — kept for backward compat)
    // New data should go to users/{uid}.medicalProfile
    // ═══════════════════════════════════════════════════════════════════════

    match /patient_profiles/{userId} {
      allow read: if isDashboardUser() || isAmbulance();
      allow write: if isOwner(userId) || isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Admins  (mobile app admin collection)
    // ═══════════════════════════════════════════════════════════════════════

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow write: if isAppAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Dashboard Users
    // ═══════════════════════════════════════════════════════════════════════

    match /dashboard_users/{uid} {
      allow read: if isOwner(uid) || isDashboardUser();
      allow write: if isDashboardAdmin();
    }

    match /_counters/{docId} {
      allow read, write: if true;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Default — authenticated read / admin write only
    // ═══════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
