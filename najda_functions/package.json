{
  "name": "najda-functions",
  "description": "Najda Emergency Response – Firebase Cloud Functions v2",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "firebase emulators:exec --project demo-najda-test --only firestore,storage \"tsx test/rules.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-najda-test --only firestore,auth,functions \"tsx test/e2e-sos.test.ts\""
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "geofire-common": "^6.0.0",
    "groq-sdk": "^0.5.0",
    "axios": "^1.6.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "tsx": "^4.19.0"
  },
  "private": true
}
