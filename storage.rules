rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Cross-service read of the Firestore dashboard_users doc — mirrors
    // firestore.rules' isDashboardUser() (exists AND active==true).
    function isDashboardUser() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/dashboard_users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/dashboard_users/$(request.auth.uid)).data.active == true;
    }

    // Accident/incident photos uploaded by the reporting citizen.
    // Read: the owner, or a dashboard user reviewing the report.
    match /incidents/{uid}/{fileName} {
      allow read: if isOwner(uid) || isDashboardUser();
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny — everything else must be explicitly allowed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
