rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mobile app admin (admins/ collection)
    function isAppAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dashboard user (any role)
    function isDashboardUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/dashboard_users/$(request.auth.uid));
    }

    // Dashboard admin specifically
    function isDashboardAdmin() {
      return isDashboardUser() &&
        get(/databases/$(database)/documents/dashboard_users/$(request.auth.uid)).data.role == "admin";
    }

    // Either admin type
    function isAdmin() {
      return isAppAdmin() || isDashboardAdmin();
    }

    // Registered citizen
    function isCitizen() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/citizens/$(request.auth.uid));
    }

    // Registered paramedic
    function isParamedic() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/paramedics/$(request.auth.uid));
    }

    // Owner of the incident (unified schema uses reportedBy, not patientUid)
    function isIncidentOwner() {
      return isAuthenticated() && resource.data.reportedBy == request.auth.uid;
    }

    // Paramedic assigned to this incident (unified schema: assignment.paramedicId)
    function isAssignedParamedic() {
      return isAuthenticated() &&
        resource.data.get('assignment', {}).get('paramedicId', '') == request.auth.uid;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Users  (shared profile — both citizen and paramedic have a doc here)
    // Written at registration by the mobile app
    // ═══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Own read/write
      allow read, write: if isOwner(userId);

      // Dashboard + App Admin can read (for medical profile in SOS)
      allow read: if isDashboardUser() || isAppAdmin();

      // Paramedics can read for incident context
      allow read: if isParamedic();

      // Only admins can delete
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Citizens  (role-specific collection for exists() checks)
    // ═══════════════════════════════════════════════════════════════════════

    match /citizens/{userId} {
      allow read: if isOwner(userId) || isParamedic() || isDashboardUser() || isAppAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin() || isDashboardUser();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Incidents  (unified — replaces reports/ + emergency_reports/)
    //
    // Unified schema fields used in rules:
    //   reportedBy        — who created the incident (citizen uid)
    //   assignment.paramedicId — assigned paramedic uid
    //   status, assignment, assignedHospital, timeline, resolvedAt — protected
    // ═══════════════════════════════════════════════════════════════════════

    match /incidents/{incidentId} {

      // Everyone authenticated can read
      allow read: if isAuthenticated();

      // Citizens and paramedics can create (accident report, SOS)
      allow create: if isCitizen() || isParamedic();

      // Dashboard has full update authority
      allow update: if isDashboardUser();

      // Citizen can update their own incident — but NOT critical operational fields
      allow update: if isIncidentOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'status',
            'assignment',
            'assignedHospital',
            'resolvedAt',
            'timeline'
          ]);

      // Assigned paramedic can update only operational fields
      allow update: if isAssignedParamedic()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'resolvedAt',
            'timeline'
          ]);

      allow delete: if isAdmin() || isDashboardUser();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Tracking  (high-frequency GPS writes — separate from ambulances/)
    //
    // Written every 3–5 seconds by the paramedic's device.
    // Read by Dashboard LiveMap in real time.
    //
    // Security note: we allow any authenticated paramedic to write to
    // tracking/{ambulanceId}. A stricter check (verifying the paramedic
    // owns this ambulance) would require an extra Firestore read on every
    // GPS update (every 4s) which is expensive. Instead, Cloud Functions
    // validate ownership server-side before acting on tracking data.
    // ═══════════════════════════════════════════════════════════════════════

    match /tracking/{ambulanceId} {

      // Paramedics write their own location
      allow write: if isParamedic();

      // Dashboard + paramedics + admins can read
      allow read: if isDashboardUser() || isParamedic() || isAppAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Ambulances
    // ═══════════════════════════════════════════════════════════════════════

    match /ambulances/{ambulanceId} {

      // All authenticated users can read (citizen may need ETA info)
      allow read: if isAuthenticated();

      // Dashboard full access
      allow read, write: if isDashboardUser();

      // App Admin full access
      allow write: if isAppAdmin();

      // Paramedic can update only their own ambulance's location + status
      // (currentLocation is aggregated from tracking/ by Cloud Function,
      //  but paramedic may also update status directly)
      allow update: if isParamedic()
        && resource.data.get('paramedicId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'lastActiveAt',
            'updatedAt'
          ]);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Paramedics
    // ═══════════════════════════════════════════════════════════════════════

    match /paramedics/{userId} {

      // Dashboard + App Admin full access
      allow read, write: if isDashboardUser() || isAppAdmin();

      // Paramedic reads their own profile
      allow read: if isOwner(userId);

      // Paramedic creates their own profile at registration
      allow create: if isOwner(userId);

      // Paramedic updates only operational fields
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'isAvailable',
            'isActive',
            'fcmToken',
            'currentAmbulanceId',
            'updatedAt'
          ]);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Assignments  (audit log — written only by Cloud Functions via Admin SDK)
    //
    // No client write allowed. Cloud Functions use Admin SDK which bypasses rules.
    // ═══════════════════════════════════════════════════════════════════════

    match /assignments/{assignmentId} {
      allow create, update, delete: if false;

      allow read: if isAdmin()
        || isDashboardUser()
        || (isParamedic() && resource.data.paramedicId == request.auth.uid);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Hospitals  (cached from Google Places — updated by admin/functions)
    // ═══════════════════════════════════════════════════════════════════════

    match /hospitals/{docId} {
      allow read: if isAuthenticated();
      allow write: if isDashboardUser() || isAppAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Notifications
    //
    // Unified schema fields:
    //   targetType  — "ambulance" | "paramedic" | "admin" | "citizen"
    //   targetId    — uid or "all" for broadcasts
    //   read        — Boolean (was "isRead" in old schema — now unified to "read")
    // ═══════════════════════════════════════════════════════════════════════

    match /notifications/{notificationId} {

      // Dashboard + App Admin full access
      allow read, write: if isDashboardUser() || isAppAdmin();

      // Paramedic reads own or broadcast notifications
      allow read: if isParamedic() && (
        resource.data.targetId == request.auth.uid ||
        resource.data.targetId == 'all'
      );

      // Paramedic marks own notification as read only (field is now "read" not "isRead")
      allow update: if isParamedic()
        && resource.data.targetId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);

      // Paramedic deletes own notification
      allow delete: if isParamedic()
        && resource.data.targetId == request.auth.uid;

      // Citizen reads own notifications (e.g. incident status updates)
      allow read: if isCitizen() && (
        resource.data.targetId == request.auth.uid ||
        resource.data.targetId == 'all'
      );

      // Citizen marks own as read
      allow update: if isCitizen()
        && resource.data.targetId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);

      // Mobile app creates notifications (SOS alert to dashboard, etc.)
      allow create: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Medical Reports  (paramedic field reports — immutable after creation)
    // ═══════════════════════════════════════════════════════════════════════

    match /medical_reports/{reportId} {
      allow read, write: if isDashboardUser() || isAppAdmin();

      allow create: if isParamedic()
        && request.resource.data.paramedicId == request.auth.uid;

      allow read: if isParamedic()
        && resource.data.paramedicId == request.auth.uid;

      // Immutable — no updates or deletes from client
      allow update, delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Paramedic History  (written only by Cloud Functions)
    // ═══════════════════════════════════════════════════════════════════════

    match /paramedic_history/{historyId} {
      allow create, update, delete: if false;

      allow read: if isAdmin()
        || isDashboardUser()
        || (isParamedic() && resource.data.paramedicId == request.auth.uid);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Mission Cancellations  (immutable after creation)
    // ═══════════════════════════════════════════════════════════════════════

    match /mission_cancellations/{docId} {
      allow create: if isParamedic()
        && request.resource.data.paramedicId == request.auth.uid;

      allow read: if isAdmin()
        || isDashboardUser()
        || (isParamedic() && resource.data.paramedicId == request.auth.uid);

      allow update, delete: if false;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Join Requests  (public form submission)
    // ═══════════════════════════════════════════════════════════════════════

    match /join_requests/{requestId} {
      // Anyone can submit (public form, no auth required)
      allow create: if true;

      // Only dashboard/admin can read and process
      allow read, update: if isAdmin() || isDashboardUser();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Patient Profiles  (legacy — kept for backward compat)
    // New data should go to users/{uid}.medicalProfile
    // ═══════════════════════════════════════════════════════════════════════

    match /patient_profiles/{userId} {
      allow read: if isDashboardUser() || isParamedic();
      allow write: if isOwner(userId) || isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Admins  (mobile app admin collection)
    // ═══════════════════════════════════════════════════════════════════════

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow write: if isAppAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Dashboard Users
    // ═══════════════════════════════════════════════════════════════════════

    match /dashboard_users/{uid} {
      allow read: if isOwner(uid) || isDashboardUser();
      allow write: if isDashboardAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════
    // Default — authenticated read / admin write only
    // ═══════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
